; Engine configuration file.
; Carry Queen Pinball - "Ich bin die Beste (gern geschehen)"

config_version=5

[application]

config/name="Carry Queen Pinball"
config/description="Ich bin die Beste - das Flipperspiel. Gern geschehen."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=660
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; Auf dem Telefon hochkant - der Tisch ist 660 mal 960 und laege quer auf
; der Seite.  Ohne diese Zeile startet Godot dort im Querformat.
window/handheld/orientation=1

[input_devices]

; Gestupst wird auf dem Telefon durch Kippen des Geraets.  Godot laesst den
; Beschleunigungsmesser sonst aus (er kostet Strom) und liefert dann einen
; Nullvektor - genau daran passierte beim ersten Versuch im Emulator nichts.
sensors/enable_accelerometer=true

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=1250.0

[rendering]

viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.04, 1)
; Ohne ETC2/ASTC verweigert Godot den Android-Export.  Der Tisch ist ohnehin
; gezeichnet, betroffen sind nur das Symbol und das Bild der Queen.
textures/vram_compression/import_etc2_astc=true
; Auf Android ueber OpenGL statt Vulkan.  Mit Vulkan blieb das Bild im
; Emulator schwarz, bei jedem Bild "Couldn't present to Vulkan queue" - auch
; mit Software-Grafik.  Der Browser-Build laeuft ohnehin schon so.
renderer/rendering_method.mobile="gl_compatibility"
