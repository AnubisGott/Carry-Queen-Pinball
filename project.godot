; Engine configuration file.
; Carry Queen Pinball - "Ich bin die Beste (gern geschehen)"

config_version=5

[application]

config/name="Carry Queen Pinball"
config/description="Ich bin die Beste - das Flipperspiel. Gern geschehen."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=660
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=1250.0

[rendering]

viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.04, 1)
